# 生产环境配置：复制为 .env.prod 并逐项填写，切勿提交到版本库。
# cp .env.prod.example .env.prod

APP_NAME=智能少儿编程教育管理系统
APP_VERSION=0.1.0
DEBUG=false

# 务必替换为随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为随机密钥
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 如前后端分域名部署，把前端域名追加进来（逗号分隔）；同域经 nginx 反代可留空
CORS_ORIGINS=

# 数据库连接由 compose 自动拼接（db 服务），本文件可留空；独立部署时取消注释填写
# DATABASE_URL=postgresql+psycopg://app:强密码@db:5432/child_code
POSTGRES_USER=app
POSTGRES_PASSWORD=请替换为强密码
POSTGRES_DB=child_code

# 对外端口
WEB_PORT=8080

# 模型配置（AI 出题/评估需要；不配则相关功能返回兜底）
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=
LLM_BASE_URL=
# RAG 知识库 embedding（与上面同厂商；如千问 text-embedding-v3；留空则用教师自配）
LLM_EMBED_MODEL=

# 首个管理员账号（首次部署 seed 用，建好后可删除这三行）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=请替换为强密码
SEED_ADMIN_NAME=管理员
