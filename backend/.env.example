# 复制为 .env 并按环境修改。切勿将真实 .env 提交到版本库。
APP_NAME=智能少儿编程教育管理系统
APP_VERSION=0.1.0
DEBUG=false
# 运行环境：dev / test / prod。prod 下启动时强校验 SECRET_KEY 等安全配置（不合规拒绝启动）
APP_ENV=dev

# 生产环境务必替换为随机密钥（uv run python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-in-production
# 密钥轮换（可选）：旧密钥逗号分隔，解密兼容（已加密的模型 Key 不失效）
# SECRET_KEY_PREVIOUS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 自助注册（默认关闭）：开启后仅家长/学员可自助注册；管理员/教师/教务由管理员创建
ALLOW_SELF_REGISTRATION=false
# 上传素材签名 URL 有效期（秒）
MEDIA_URL_TTL_SECONDS=86400

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/child_code

# 启动期 schema 策略（ADR-0029）：auto=自动建表补列 / verify=只读校验告警 / off=跳过
# 存量库完成 `alembic stamp a00000000000` 后建议切 verify
SCHEMA_ENSURE_MODE=auto

# 模型配置（M3+ 使用，默认 deepseek-v4-pro，可自定义）
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=
LLM_BASE_URL=