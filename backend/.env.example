# 复制为 .env 并按环境修改。切勿将真实 .env 提交到版本库。
APP_NAME=智能少儿编程教育管理系统
APP_VERSION=0.1.0
DEBUG=false

# 生产环境务必替换为随机密钥（uv run python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/child_code

# 模型配置（M3+ 使用，默认 deepseek-v4-pro，可自定义）
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=
LLM_BASE_URL=